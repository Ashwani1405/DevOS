# Configuration for the site.
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env

# GITHUB_TOKEN / GITHUB_USERNAME
#   Used at build time only — never sent to the browser. The homepage's GitHub
#   section fetches your contribution graph and pull-request activity via
#   GitHub's GraphQL API during `astro build`.
#   Create a token at: https://github.com/settings/tokens
#   Suggested scopes: `read:user`, `repo` (for private activity) or the
#   minimal scopes needed for public data.
GITHUB_TOKEN=your_github_pat_here
GITHUB_USERNAME=yashbhu

# OBSIDIAN_VAULT_PATH
#   Absolute path to the canonical source-of-truth Obsidian vault. The vault
#   holds Writing/, Projects/, Shelf/, Work/, Yash/ and Config/ directories.
#   `npm run sync` imports this vault into the committed, deployable site
#   snapshot (`content/`), which Astro builds from. The private vault is never
#   read directly at build time — only the generated snapshot is published.
#   If unset, OBSIDIAN_VAULT_PATH defaults to ~/Documents/Obsidian Vault.
OBSIDIAN_VAULT_PATH=


SPOTIFY_CLIENT_ID=83dc8cb8d7a9449b8fb7e5b08281b6f7
SPOTIFY_CLIENT_SECRET=ec30dcc3b8dc461289c6051a74825956
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4321/api/spotify/callback
