---
import Layout from "../../layouts/Base.astro";
import { getWork } from "../../lib/content/index";
import { site } from "../../data/site";

const work = await getWork();
---

<Layout title="Work" description="Professional experience and work history.">
  <div class="work-page">
    <div class="page-hero">
      <h1>work</h1>
    </div>

    <!-- Intro card -->
    <div class="work-intro card">
      <p>
        {site.bio}
      </p>
      <a href={site.social.resume} class="resume-btn">
        Resume ↓
      </a>
    </div>

    <!-- Experience section -->
    <section class="section">
      <h2 class="section-title">EXPERIENCE</h2>
      <div class="experience-card card">
        {work.length === 0 ? (
          <p class="muted">No work experience entries found. Add .md files to content/work/.</p>
        ) : (
          <ul class="exp-list">
            {work.map((item, i) => (
              <li class:list={["exp-item", { "exp-item--last": i === work.length - 1 }]}>
                <div class="exp-header">
                  <div>
                    <h3 class="exp-role">{item.title}</h3>
                    <p class="exp-company">{item.company}</p>
                  </div>
                  <div class="exp-dates">
                    <span>{item.startDate} — {item.endDate ?? "Present"}</span>
                    {item.location && (
                      <span class="exp-location">{item.location}{item.remote ? " · Remote" : ""}</span>
                    )}
                  </div>
                </div>
                {item.description && <p class="exp-desc">{item.description}</p>}
                {item.bullets.length > 0 && (
                  <ul class="exp-bullets">
                    {item.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {item.technologies.length > 0 && (
                  <div class="exp-tech">
                    {item.technologies.map((tech) => (
                      <span class="exp-tech-tag">{tech}</span>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </div>
</Layout>

<style>
  .work-page {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .work-intro {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .resume-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    background: var(--accent-subtle);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .resume-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .experience-card {
    padding: 0;
    overflow: hidden;
  }

  .exp-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .exp-item {
    padding: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .exp-item--last {
    border-bottom: none;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .exp-role {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0;
  }

  .exp-company {
    font-size: 0.9375rem;
    color: var(--accent);
    margin: 0.15rem 0 0;
  }

  .exp-dates {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .exp-location {
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .exp-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0 0 0.5rem;
  }

  .exp-bullets {
    padding-left: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .exp-bullets li {
    margin-bottom: 0.25rem;
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .exp-tech-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    background: var(--accent-subtle);
    border-radius: 4px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .exp-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .exp-dates {
      align-items: flex-start;
    }

    .exp-item {
      padding: 1.25rem;
    }
  }
</style>